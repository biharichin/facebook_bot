[{"question_text": "\ud835\udde4\ud835\udfed: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddfa\ud835\uddf2\ud835\uddee\ud835\uddfb\ud835\uddf6\ud835\uddfb\ud835\uddf4 \ud835\uddfc\ud835\uddf3 \"\ud835\uddd4\ud835\uddfb\ud835\ude05\ud835\uddf6\ud835\uddfc\ud835\ude02\ud835\ude00\"?", "options": ["Fluent and expressive", "Showing no interest", "Very worried"], "correct_answer_text": "Very worried"}, {"question_text": "\ud835\udde4\ud835\udfee: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\ude00\ud835\ude06\ud835\uddfb\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\uddd4\ud835\uddfb\ud835\ude05\ud835\uddf6\ud835\uddfc\ud835\ude02\ud835\ude00\"?", "options": ["Vague, unclear", "Forward-thinking, active", "Nervous, uneasy"], "correct_answer_text": "Nervous, uneasy"}, {"question_text": "\ud835\udde4\ud835\udfef: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddee\ud835\uddfb\ud835\ude01\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\uddd4\ud835\uddfb\ud835\ude05\ud835\uddf6\ud835\uddfc\ud835\ude02\ud835\ude00\"?", "options": ["Foolish, dull", "Relaxed, calm", "Ashamed, embarrassed"], "correct_answer_text": "Relaxed, calm"}, {"question_text": "\ud835\udde4\ud835\udff0: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddfa\ud835\uddf2\ud835\uddee\ud835\uddfb\ud835\uddf6\ud835\uddfb\ud835\uddf4 \ud835\uddfc\ud835\uddf3 \"\ud835\uddd4\ud835\uddf1\ud835\uddee\ud835\uddfd\ud835\ude01\ud835\uddee\ud835\uddef\ud835\uddf9\ud835\uddf2\"?", "options": ["Showing disrespect", "Adjusts easily", "Using few words"], "correct_answer_text": "Adjusts easily"}, {"question_text": "\ud835\udde4\ud835\udff1: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\ude00\ud835\ude06\ud835\uddfb\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\uddd4\ud835\uddf1\ud835\uddee\ud835\uddfd\ud835\ude01\ud835\uddee\ud835\uddef\ud835\uddf9\ud835\uddf2\"?", "options": ["Update, enhance", "Logical, reasoned", "Flexible, versatile"], "correct_answer_text": "Flexible, versatile"}, {"question_text": "\ud835\udde4\ud835\udff2: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddee\ud835\uddfb\ud835\ude01\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\uddd4\ud835\uddf1\ud835\uddee\ud835\uddfd\ud835\ude01\ud835\uddee\ud835\uddef\ud835\uddf9\ud835\uddf2\"?", "options": ["Selfish, stingy", "Fun, interesting", "Rigid, stubborn"], "correct_answer_text": "Rigid, stubborn"}, {"question_text": "\ud835\udde4\ud835\udff3: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddfa\ud835\uddf2\ud835\uddee\ud835\uddfb\ud835\uddf6\ud835\uddfb\ud835\uddf4 \ud835\uddfc\ud835\uddf3 \"\ud835\uddd4\ud835\uddf1\ud835\ude03\ud835\uddf2\ud835\uddfb\ud835\ude01\ud835\ude02\ud835\uddff\ud835\uddfc\ud835\ude02\ud835\ude00\"?", "options": ["Likes risk and excitement", "Feeling shy or ashamed", "Acting without thinking"], "correct_answer_text": "Likes risk and excitement"}, {"question_text": "\ud835\udde4\ud835\udff4: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\ude00\ud835\ude06