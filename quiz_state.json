[{"question_text": "\ud835\udde4\ud835\udfed: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddfa\ud835\uddf2\ud835\uddee\ud835\uddfb\ud835\uddf6\ud835\uddfb\ud835\uddf4 \ud835\uddfc\ud835\uddf3 \"\ud835\udde9\ud835\uddf6\ud835\uddff\ud835\uddee\ud835\uddf9 (\ud835\uddd4\ud835\uddf1\ud835\uddf7)\"?", "options": ["Acting superior", "Spreading rapidly online", "Showing subtle differences"], "correct_answer_text": "Spreading rapidly online"}, {"question_text": "\ud835\udde4\ud835\udfee: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\ude00\ud835\ude06\ud835\uddfb\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\udde9\ud835\uddf6\ud835\uddff\ud835\uddee\ud835\uddf9 (\ud835\uddd4\ud835\uddf1\ud835\uddf7)\"?", "options": ["Bright, vivid", "Popular, widespread", "Harmonize, settle"], "correct_answer_text": "Popular, widespread"}, {"question_text": "\ud835\udde4\ud835\udfef: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddee\ud835\uddfb\ud835\ude01\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\udde9\ud835\uddf6\ud835\uddff\ud835\uddee\ud835\uddf9 (\ud835\uddd4\ud835\uddf1\ud835\uddf7)\"?", "options": ["Separate, isolate", "Respectful, admiring", "Unnoticed, obscure"], "correct_answer_text": "Unnoticed, obscure"}, {"question_text": "\ud835\udde4\ud835\udff0: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddfa\ud835\uddf2\ud835\uddee\ud835\uddfb\ud835\uddf6\ud835\uddfb\ud835\uddf4 \ud835\uddfc\ud835\uddf3 \"\ud835\udddc\ud835\uddfb\ud835\uddf3\ud835\uddf9\ud835\ude02\ud835\uddf2\ud835\uddfb\ud835\uddf0\ud835\uddf2\ud835\uddff (\ud835\udde1\ud835\uddfc\ud835\ude02\ud835\uddfb)\"?", "options": ["Strongly influenced positively", "Very slow", "A person who affects others\u2019 buying or opinions"], "correct_answer_text": "A person who affects others\u2019 buying or opinions"}, {"question_text": "\ud835\udde4\ud835\udff1: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\ude00\ud835\ude06\ud835\uddfb\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\udddc\ud835\uddfb\ud835\uddf3\ud835\uddf9\ud835\ude02\ud835\uddf2\ud835\uddfb\ud835\uddf0\ud835\uddf2\ud835\uddff (\ud835\udde1\ud835\uddfc\ud835\ude02\ud835\uddfb)\"?", "options": ["Brutal, savage", "Magnificent, regal", "Promoter, trendsetter"], "correct_answer_text": "Promoter, trendsetter"}, {"question_text": "\ud835\udde4\ud835\udff2: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddee\ud835\uddfb\ud835\ude01\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\udddc\ud835\uddfb\ud835\uddf3\ud835\uddf9\ud835\ude02\ud835\uddf2\ud835\uddfb\ud835\uddf0\ud835\uddf2\ud835\uddff (\ud835\udde1\ud835\uddfc\ud835\ude02\ud835\uddfb)\"?", "options": ["Follower, unknown", "Careful, cautious", "Doubtful, unreliable"], "correct_answer_text": "Follower, unknown"}, {"question_text": "\ud835\udde4\ud835\udff3: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddfa\ud835\uddf2\ud835\uddee\ud835\uddfb\ud835\uddf6\ud835\uddfb\ud835\uddf4 \ud835\uddfc\ud835\uddf3 \"\ud835\uddd5\ud835\uddf6\ud835\uddfb\ud835\uddf4\ud835\uddf2-\ud835\ude04\ud835\uddee\ud835\ude01\ud835\uddf0\ud835\uddf5 (\ud835\udde