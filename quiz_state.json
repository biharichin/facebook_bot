[{"question_text": "\ud835\udde4\ud835\udfed: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddfa\ud835\uddf2\ud835\uddee\ud835\uddfb\ud835\uddf6\ud835\uddfb\ud835\uddf4 \ud835\uddfc\ud835\uddf3 \"\ud835\udde6\ud835\ude01\ud835\ude02\ud835\uddef\ud835\uddef\ud835\uddfc\ud835\uddff\ud835\uddfb\"?", "options": ["Expect in advance", "Formal discussion", "Refuses to change opinion"], "correct_answer_text": "Refuses to change opinion"}, {"question_text": "\ud835\udde4\ud835\udfee: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\ude00\ud835\ude06\ud835\uddfb\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\udde6\ud835\ude01\ud835\ude02\ud835\uddef\ud835\uddef\ud835\uddfc\ud835\uddff\ud835\uddfb\"?", "options": ["Obstinate, rigid", "Pacify, soothe, placate", "Meticulous, picky"], "correct_answer_text": "Obstinate, rigid"}, {"question_text": "\ud835\udde4\ud835\udfef: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddee\ud835\uddfb\ud835\ude01\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\udde6\ud835\ude01\ud835\ude02\ud835\uddef\ud835\uddef\ud835\uddfc\ud835\uddff\ud835\uddfb\"?", "options": ["Introverted, reserved", "Flexible, adaptable", "Careless, sloppy"], "correct_answer_text": "Flexible, adaptable"}, {"question_text": "\ud835\udde4\ud835\udff0: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddfa\ud835\uddf2\ud835\uddee\ud835\uddfb\ud835\uddf6\ud835\uddfb\ud835\uddf4 \ud835\uddfc\ud835\uddf3 \"\ud835\uddd9\ud835\uddfc\ud835\uddff\ud835\uddf4\ud835\uddf6\ud835\ude03\ud835\uddf6\ud835\uddfb\ud835\uddf4\"?", "options": ["Ready to forgive", "Open and honest", "Very worried or panicked"], "correct_answer_text": "Ready to forgive"}, {"question_text": "\ud835\udde4\ud835\udff1: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\ude00\ud835\ude06\ud835\uddfb\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\uddd9\ud835\uddfc\ud835\uddff\ud835\uddf4\ud835\uddf6\ud835\ude03\ud835\uddf6\ud835\uddfb\ud835\uddf4\"?", "options": ["Relaxed, composed", "Terrified, paralyzed", "Merciful, lenient"], "correct_answer_text": "Merciful, lenient"}, {"question_text": "\ud835\udde4\ud835\udff2: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddee\ud835\uddfb\ud835\ude01\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\uddd9\ud835\uddfc\ud835\uddff\ud835\uddf4\ud835\uddf6\ud835\ude03\ud835\uddf6\ud835\uddfb\ud835\uddf4\"?", "options": ["Contradiction", "Unforgiving, harsh", "Silence, neglect"], "correct_answer_text": "Unforgiving, harsh"}, {"question_text": "\ud835\udde4\ud835\udff3: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddfa\ud835\uddf2\ud835\uddee\ud835\uddfb\ud835\uddf6\ud835\uddfb\ud835\uddf4 \ud835\uddfc\ud835\uddf3 \"\ud835\udde6\ud835\uddf2\ud835\uddf9\ud835\uddf3\ud835\uddf6\ud835\ude00\ud835\uddf5\"?", "options": ["Cares only about self", "To calm or satisfy", "Shows empathy"], "correct_answer_text": "Cares only about self"}, {"question_text": "\ud835\udde4\ud835\udff4: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\ude00\ud835\ude06\ud835\uddfb\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\udde6\ud835\uddf2\ud835\uddf9\ud835\uddf3\ud835\uddf6\ud835\ude00\ud835\uddf5\"?", "options": ["Self-centered, greedy", "Integrate, merge", "Chatty, verbose"], "correct_answer_text": "Self-centered, greedy"}, {"question_text": "\ud835\udde4\ud835\udff5: \ud835\uddea\ud835\uddf5\ud835\uddee\ud835\ude01 \ud835\uddf6\ud835\ude00/\ud835\uddee\ud835\uddff\ud835\uddf2 \ud835\ude01\ud835\uddf5\ud835\uddf2 \ud835\uddee\ud835\uddfb\ud835\ude01\ud835\uddfc\ud835\uddfb\ud835\ude06\ud835\uddfa\ud835\ude00 \ud835\uddfc\ud835\uddf3 \"\ud835\udde6\ud835\uddf2\ud835\uddf9\ud835\uddf3\ud835\uddf6\ud835\ude00\ud835\uddf5\"?", "options": ["Selfless, generous", "Cowardly, timid", "On-site, physical"], "correct_answer_text": "Selfless, generous"}]